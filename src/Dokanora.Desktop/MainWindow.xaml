<Window x:Class="Dokanora.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="দোকানোরা — উন্নয়ন সংস্করণ" Width="760" Height="480"
        MinWidth="600" MinHeight="380" WindowStartupLocation="CenterScreen"
        Background="#F7FAF8" FontFamily="Nirmala UI, Segoe UI" Foreground="{StaticResource TextPrimary}">
    <Grid Margin="40">
        <Border Background="White" BorderBrush="#DCE8E3" BorderThickness="1" CornerRadius="12" Padding="32"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="দোকানোরা" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                <TextBlock Text="খুচরা ব্যবসা ব্যবস্থাপনা" FontSize="18" Margin="0,6,0,24" />
                <TextBlock Text="এটি একটি প্রাথমিক উন্নয়ন সংস্করণ।" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="বিক্রয়, স্টক, হিসাব, লাইসেন্স এবং ব্যাকআপ এখনো চালু নয়। ব্যবসার তথ্য সংরক্ষণ বা পরিচালনার জন্য এই সংস্করণ ব্যবহার করবেন না।"
                           Margin="0,12,0,0" FontSize="15" LineHeight="25" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
